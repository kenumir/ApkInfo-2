<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/filter_bg_pressed" />
            <stroke android:color="@color/filter_border_pressed" android:width="1dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/filter_bg" />
            <stroke android:color="@color/filter_border" android:width="1dp" />
        </shape>
    </item>

</selector>