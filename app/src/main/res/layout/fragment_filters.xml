<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        style="@style/TextAppearance.MaterialComponents.Headline6"
        android:id="@+id/filterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sortowanie" />

    <RadioGroup
        style="@style/List_FilterRadioGroup"
        android:id="@+id/radios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            style="@style/List_FilterRadio.First"
            android:id="@+id/optionFirst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nazwa"
            android:checked="true"/>

        <View
            style="@style/List_FilterDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <RadioButton
            style="@style/List_FilterRadio"
            android:id="@+id/option1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data" />

        <View
            style="@style/List_FilterDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <RadioButton
            style="@style/List_FilterRadio.Last"
            android:id="@+id/optionLast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pakiet"/>
    </RadioGroup>

</LinearLayout>