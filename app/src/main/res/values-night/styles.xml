<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="AppTheme_Base">
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="StartTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/start_bg</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccentDark</item>
    </style>

    <!-- Toolbar -->
    <style name="AppToolbarStyleMain" parent="@style/AppToolbarStyleMain_Base">
        <item name="android:background">@drawable/toolbar_bg_night</item>
    </style>
    <style name="AppToolbarStyle" parent="Widget.MaterialComponents.Toolbar">
        <item name="navigationIconTint">?android:attr/textColorPrimary</item>
    </style>

    <style name="List_FilterRadioGroup" parent="@style/List_FilterRadioGroup_Base">
        <item name="android:background">@drawable/filter_radio_list_bg_night</item>
    </style>
    <style name="List_FilterItem" parent="@style/List_FilterItemBase">
        <item name="android:background">@drawable/filter_bg_night</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:drawableTint" tools:ignore="NewApi">?android:attr/textColorPrimary</item>
    </style>
    <style name="List_FilterRadio" parent="@style/List_FilterRadio_Base">
        <item name="android:background">@drawable/filter_radio_bg_night</item>
    </style>
    <style name="List_FilterRadio.First">
        <item name="android:background">@drawable/filter_radio_bg_first_night</item>
    </style>
    <style name="List_FilterRadio.Last">
        <item name="android:background">@drawable/filter_radio_bg_last_night</item>
    </style>
    <style name="List_FilterDivider">
        <item name="android:background">@color/filter_divider_night</item>
    </style>

</resources>
