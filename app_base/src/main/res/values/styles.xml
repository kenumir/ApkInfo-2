<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme_Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorPrimaryDark">?colorSurface</item>
        <item name="colorSecondary">?colorSurface</item>
        <item name="colorAccent">@color/md_theme_light_tertiary</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>

        <item name="android:fontFamily">@font/roboto_flex</item>
        <item name="fontFamily">@font/roboto_flex</item>

        <!-- Material 3 Expressive Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Material3.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Material3.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Material3.DisplaySmall</item>

        <!-- Material 3 Expressive Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Material3.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Material3.LargeComponent</item>

        <!-- Motion -->
        <item name="motionDurationLong1">@android:integer/config_longAnimTime</item>
        <item name="motionEasingEmphasized">@android:interpolator/fast_out_slow_in</item>

        <!-- Fix Activity Transitions -->
        <item name="android:windowAnimationStyle">@style/Animation.App.Activity</item>
    </style>

    <style name="Animation.App.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="AppTheme" parent="AppTheme_Base">
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="StartTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/start_bg</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Toolbar -->
    <style name="AppToolbarStyleMain_Base" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:navigationIcon" tools:targetApi="lollipop">@drawable/ic_search_suggest</item>
        <item name="navigationIcon" tools:targetApi="lollipop">@drawable/ic_search_suggest</item>
        <item name="materialThemeOverlay">@style/AppToolbarStyleMain_Overlay</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation" tools:targetApi="lollipop">0dp</item>
        <item name="titleTextAppearance">@style/AppToolbarStyleMain_Text</item>
        <item name="navigationIconTint">?android:attr/textColorPrimary</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
    </style>
    <style name="AppToolbarStyleMain" parent="@style/AppToolbarStyleMain_Base">
        <item name="android:background">@drawable/toolbar_bg</item>
    </style>
    <style name="AppToolbarStyleMain_Overlay" parent="">
        <item name="colorOnPrimary">?android:attr/textColorPrimary</item>
    </style>
    <style name="AppToolbarStyleMain_Text" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/roboto_flex</item>
        <item name="fontFamily">@font/roboto_flex</item>
    </style>


    <style name="AppToolbarStyle" parent="Widget.MaterialComponents.Toolbar">
        <item name="navigationIconTint">?android:attr/textColorPrimary</item>
        <item name="colorControlNormal">?android:attr/textColorPrimary</item>
    </style>

    <!-- lists elements -->
    <style name="List_Header">
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
        <item name="android:layout_marginTop">@dimen/list_vertical_margin</item>
        <item name="android:layout_marginLeft">@dimen/list_horizontal_margin</item>
        <item name="android:layout_marginRight">@dimen/list_horizontal_margin</item>
    </style>
    <style name="List_DoubleItem_Box">
        <item name="android:paddingLeft">@dimen/list_horizontal_margin</item>
        <item name="android:paddingRight">@dimen/list_horizontal_margin</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">@dimen/list_double_item_height</item>
    </style>
    <style name="List_DoubleItem_Key">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
    <style name="List_DoubleItem_Value">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="List_SingleItem">
        <item name="android:paddingLeft">@dimen/list_horizontal_margin</item>
        <item name="android:paddingRight">@dimen/list_horizontal_margin</item>
        <item name="android:minHeight">@dimen/list_single_item_height</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="drawableRightCompat">@drawable/ic_chevron_right</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:textDirection">locale</item>
    </style>

    <style name="List_FilterItemBase">
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableEnd">@drawable/ic_arrow_drop_down_24</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="List_FilterItem" parent="@style/List_FilterItemBase">
        <item name="android:background">@drawable/filter_bg</item>
        <item name="android:textColor">@color/filter_text</item>
        <item name="android:drawableTint" tools:ignore="NewApi">@color/filter_text</item>
    </style>

    <style name="List_FilterRadioGroup_Base">
        <item name="android:background">@drawable/filter_radio_list_bg</item>
        <item name="android:padding">1dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
    <style name="List_FilterRadioGroup" parent="@style/List_FilterRadioGroup_Base">
    </style>
    <style name="List_FilterRadio_Base">
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/filter_radio_bg</item>
        <item name="android:button">@drawable/filter_radio_button_inset</item>
    </style>
    <style name="List_FilterRadio" parent="@style/List_FilterRadio_Base">
    </style>
    <style name="List_FilterRadio.First">
        <item name="android:background">@drawable/filter_radio_bg_first</item>
    </style>
    <style name="List_FilterRadio.Last">
        <item name="android:background">@drawable/filter_radio_bg_last</item>
    </style>
    <style name="List_FilterDivider">
        <item name="android:background">@color/filter_divider</item>
    </style>

    <!-- app details -->
    <style name="MainAction">
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:lines">2</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="drawableTint">?android:attr/textColorPrimary</item>
    </style>

</resources>
